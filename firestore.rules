rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // 1. THE MASTER GATE & GLOBAL HELPERS
    // ===============================================================
    
    // Default deny: All-or-nothing protection
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role-based access: Checked against trusted database
    function isAdmin() {
      return isSignedIn() && 
             ('email' in request.auth.token) &&
             (request.auth.token.email.lower() == "lizlifestylebd@gmail.com" ||
              request.auth.token.email.lower() == "joseph.nasif@gmail.com");
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ===============================================================
    // 2. VALIDATION BLUEPRINTS (The Anti-Update-Gap)
    // ===============================================================

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'inventory']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() <= 100 &&
             data.inventory is list && data.inventory.size() <= 100 &&
             (!data.keys().contains('display_order') || data.display_order is number) &&
             (!data.keys().contains('description') || (data.description is string && data.description.size() <= 5000)) &&
             (!data.keys().contains('product_code') || (data.product_code is string && data.product_code.size() <= 100)) &&
             (!data.keys().contains('image') || (data.image is string && data.image.size() <= 1000));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customer_name', 'phone', 'address', 'items', 'total_amount', 'status', 'created_at']) &&
             data.customer_name is string && data.customer_name.size() > 0 && data.customer_name.size() <= 200 &&
             data.phone is string && data.phone.size() > 7 && data.phone.size() <= 30 &&
             data.address is string && data.address.size() > 0 && data.address.size() <= 1000 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.total_amount is number && data.total_amount >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             (!data.keys().contains('user_id') || (data.user_id == null || isAdmin() || (isSignedIn() && data.user_id == request.auth.uid))) &&
             (!data.keys().contains('delivery_location') || data.delivery_location is string) &&
             (!data.keys().contains('delivery_charge') || data.delivery_charge is number);
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['email', 'displayName']) &&
             data.email is string && data.email.size() <= 255 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!data.keys().contains('created_at') || data.created_at is string) &&
             (!data.keys().contains('phone') || data.phone is string) &&
             (!data.keys().contains('address') || data.address is string) &&
             (!data.keys().contains('default_delivery_location') || data.default_delivery_location is string);
    }

    // ===============================================================
    // 3. COLLECTION RULES
    // ===============================================================

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
      allow update: if (
        isAdmin() && isValidProduct(incoming())
      ) || (
        // Pillar 1 & 4: Inventory synchronization for checkouts
        // Only allow updating inventory and updated_at if they already existed
        incoming().diff(existing()).affectedKeys().hasOnly(['inventory', 'updated_at']) &&
        incoming().inventory is list && incoming().inventory.size() <= 20
      );
    }

    // Orders
    match /orders/{orderId} {
      // Pillar 8: Secure list queries
      allow read, list: if isAdmin() || (isSignedIn() && (resource.data.user_id == request.auth.uid || request.auth.token.email.lower() == "lizlifestylebd@gmail.com" || request.auth.token.email.lower() == "joseph.nasif@gmail.com"));
      
      allow create: if isValidOrder(incoming());
      
      allow update: if isAdmin() && (
        // Action: Update status
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at']) && 
         incoming().status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled']) ||
        // Admin full update
        isValidOrder(incoming())
      );
      
      allow delete: if isAdmin();
    }

    // User Profiles
    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Role management (Legacy/Admin only)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
