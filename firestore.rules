rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // 0. GLOBAL SAFETY NET
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // 1. GLOBAL HELPERS
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Explicitly look up roles or use hardcoded admin list for this app.
    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email.lower() == "lizlifestylebd@gmail.com" ||
              request.auth.token.email.lower() == "joseph.nasif@gmail.com");
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ===============================================================
    // 2. VALIDATION BLUEPRINTS
    // ===============================================================

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'category', 'price', 'inventory', 'image', 'images', 'display_order', 'updated_at']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.inventory is list && data.inventory.size() <= 50 &&
             data.image is string && data.image.size() <= 1000 &&
             data.images is list && data.images.size() <= 20 &&
             data.display_order is number &&
             (data.updated_at == request.time) &&
             (!data.keys().contains('description') || (data.description is string && data.description.size() <= 5000)) &&
             (!data.keys().contains('original_price') || (data.original_price == null || data.original_price is number)) &&
             (!data.keys().contains('video_url') || (data.video_url is string && data.video_url.size() <= 1000)) &&
             (!data.keys().contains('product_code') || (data.product_code is string && data.product_code.size() <= 100)) &&
             (!data.keys().contains('created_at') || (data.created_at == request.time));
    }

    function isValidOrder(data) {
      // App sends: customer_name, phone, address, delivery_location, delivery_charge, total_amount, user_id (opt), items, status, created_at, updated_at
      return data.keys().hasAll(['customer_name', 'phone', 'address', 'items', 'total_amount', 'status', 'created_at', 'updated_at', 'delivery_location', 'delivery_charge']) &&
             data.customer_name is string && data.customer_name.size() > 0 && data.customer_name.size() <= 200 &&
             data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30 &&
             data.address is string && data.address.size() > 0 && data.address.size() <= 1000 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.total_amount is number && data.total_amount >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.delivery_location is string &&
             data.delivery_charge is number &&
             (!data.keys().contains('user_id') || (data.user_id is string && (isAdmin() || (isSignedIn() && data.user_id == request.auth.uid))));
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['email', 'displayName', 'created_at']) &&
             data.email is string && data.email.size() <= 255 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!data.keys().contains('phone') || (data.phone is string && data.phone.size() <= 30)) &&
             (!data.keys().contains('address') || (data.address is string && data.address.size() <= 1000)) &&
             (!data.keys().contains('default_delivery_location') || data.default_delivery_location in ['inside', 'outside']);
    }

    // ===============================================================
    // 3. COLLECTION RULES
    // ===============================================================

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
      allow update: if (
        (isAdmin() && isValidProduct(incoming())) ||
        (
          // Action: Inventory sync for checkouts
          incoming().diff(existing()).affectedKeys().hasOnly(['inventory', 'updated_at']) &&
          incoming().inventory is list &&
          incoming().updated_at == request.time
        )
      );
    }

    // Orders
    match /orders/{orderId} {
      // Admins and owners can read
      allow get: if isAdmin() || (isSignedIn() && existing().user_id == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      
      // Anyone can create (guest checkout) but must be pending
      allow create: if isValidOrder(incoming()) && incoming().status == 'pending';
      
      allow update: if isAdmin() && (
        // Action: Status update
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at']) && 
         incoming().status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
         incoming().updated_at == request.time) ||
        // Action: Full update (for admin editing)
        isValidOrder(incoming())
      );
      
      allow delete: if isAdmin();
    }

    // User Profiles
    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && 
                     incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'address', 'default_delivery_location', 'updated_at']) &&
                     (!incoming().keys().contains('displayName') || incoming().displayName is string) &&
                     (!incoming().keys().contains('phone') || (incoming().phone is string && incoming().phone.size() <= 30)) &&
                     (!incoming().keys().contains('address') || (incoming().address is string && incoming().address.size() <= 1000)) &&
                     (!incoming().keys().contains('default_delivery_location') || incoming().default_delivery_location in ['inside', 'outside']);
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
